target/
dist/

# Tauri writes these on every build, and writes a *different* set per platform
# (`linux-schema.json` here, `macOS-schema.json` on a Mac). Committing them
# would make every CI runner dirty the tree; `capabilities/default.json` refers
# to one only so an editor can autocomplete it.
desktop/gen/schemas/

# Python bytecode from the browser suites. The interpreter writes these beside
# the sources on every run, and they are per-interpreter-version
# (`cpython-312`), so committing them makes the tree dirty for anyone on a
# different Python.
__pycache__/
*.pyc

# cargo-fuzz working state. `fuzz/seeds/` is committed — those are the valid
# files every run starts from, and a fuzzer seeded with nothing spends its
# budget rediscovering the magic word. `corpus/` is what libFuzzer grows from
# them, `artifacts/` is where it drops a crashing input; both are machine
# output, and a crash worth keeping becomes a named test instead.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
